# ============================================================================
# EduAgent 环境变量配置 (统一版 — merged from src/ + backend/)
# ============================================================================
# 复制此文件为 .env 并填写真实值:
#   cp .env.example .env
# ============================================================================

# ── LLM Provider (默认: dashscope) ───────────────────────────────────────
# 可选: dashscope | spark | deepseek | openai
LLM_PROVIDER=dashscope
# Optional comma-separated providers attempted only when their credentials are configured.
EDUAGENT_LLM_FALLBACKS=deepseek,openai

# Resource generation uses one bounded attempt per provider. Concept maps are
# generated first; supporting cards run in the background as one bundle.
EDUAGENT_RESOURCE_LLM_TIMEOUT_SEC=18
EDUAGENT_RESOURCE_LLM_TOTAL_TIMEOUT_SEC=20
EDUAGENT_RESOURCE_LLM_RETRIES=1
EDUAGENT_RESOURCE_LLM_PARALLELISM=3
# Total background resource-job workers. One worker is reserved for singleton
# concept-map jobs while the remaining capacity processes supporting bundles.
EDUAGENT_RESOURCE_JOB_WORKERS=3
# Cross-instance ceiling coordinated through PostgreSQL advisory slots. Keep
# this at or below the provider capacity shared by all application replicas.
EDUAGENT_RESOURCE_GLOBAL_MAX_CONCURRENCY=3
# Slot-contended jobs retry from a worker timer; HTTP requests never wait.
EDUAGENT_RESOURCE_SLOT_RETRY_SECONDS=0.25
# Startup only reclaims a worker after this lease has expired.
EDUAGENT_RESOURCE_JOB_STALE_SECONDS=90
# Development can run the compatibility worker pool in the API process.
# Staging and production must set this to false and run src.resource_worker.
EDUAGENT_RESOURCE_IN_PROCESS_WORKERS=true

# Standalone resource-v4 worker. Production defaults are 8 replicas with
# 8 stage slots per replica, a 15-second heartbeat and a 60-second lease.
EDUAGENT_RESOURCE_WORKER_STAGE_SLOTS=8
EDUAGENT_RESOURCE_WORKER_POLL_SECONDS=0.25
EDUAGENT_RESOURCE_WORKER_HEARTBEAT_SECONDS=15
EDUAGENT_RESOURCE_WORKER_LEASE_SECONDS=60
EDUAGENT_RESOURCE_WORKER_SHUTDOWN_GRACE_SECONDS=90
EDUAGENT_RESOURCE_WORKER_INCLUDE_SHADOW=true
EDUAGENT_RESOURCE_WORKER_METRICS_SECONDS=5
EDUAGENT_RESOURCE_WORKER_RECOVERY_SECONDS=15
# Redis wakeups reduce SSE polling latency; PostgreSQL replay remains truth.
EDUAGENT_RESOURCE_EVENT_WAKE_WAIT_SECONDS=0

# Resource-v4 quality rollout is independent from the public durable-job
# rollout. A calibrated, digest-pinned NLI artifact is mandatory for exposure.
RESOURCE_QUALITY_V4_ROLLOUT_PERCENT=0
RESOURCE_QUALITY_V4_ALLOWLIST=
RESOURCE_QUALITY_V4_DENYLIST=
RESOURCE_V4_NLI_CALIBRATED=false
NLI_MODEL_ARTIFACT_DIGEST=
EDUAGENT_RESOURCE_CONTENT_VERSION=resource-v4
EDUAGENT_RESOURCE_DOMESTIC_PROVIDERS=dashscope,spark,deepseek
# Optional provider-normalized cost guard. Values are integer microunits;
# zero disables the cost gate while token and call budgets remain enforced.
EDUAGENT_RESOURCE_COST_BUDGET_MICROUNITS=0
EDUAGENT_RESOURCE_COST_PER_1K_INPUT_MICROUNITS=0
EDUAGENT_RESOURCE_COST_PER_1K_OUTPUT_MICROUNITS=0

# Resource knowledge retrieval and isolated model services.
EDUAGENT_RESOURCE_KB_RETRIEVAL_ENABLED=true
EDUAGENT_RESOURCE_KB_INDEX=resource-kb-v4-read
EDUAGENT_RESOURCE_KB_TIMEOUT_SEC=2
# Local question-bank candidates are injected only for the matching current
# node. Leave PATH empty to use the bundled normalized data-structures bank.
EDUAGENT_QUESTION_BANK_ENABLED=true
EDUAGENT_QUESTION_BANK_PATH=
EDUAGENT_QUESTION_BANK_MAX_CANDIDATES=6
# Set a stable, private value of at least 32 characters in multi-worker
# production. If empty/short, each process uses an ephemeral cryptographic key.
EDUAGENT_QUIZ_SHUFFLE_SECRET=
NLI_SERVICE_URL=
NLI_SERVICE_TOKEN=
EMBEDDING_SERVICE_URL=
EMBEDDING_SERVICE_TOKEN=
SANDBOX_RUNNER_URL=
SANDBOX_RUNNER_TOKEN=
DIAGNOSTIC_VERIFIER_URL=
DIAGNOSTIC_VERIFIER_TOKEN=

# A separate process-local listener exposes canonical Prometheus metrics
# without changing the existing frontend-owned HTTP route table.
EDUAGENT_PROMETHEUS_PORT=
EDUAGENT_PROMETHEUS_ADDRESS=0.0.0.0
RELEASE_VERSION=

# ── LLM API Keys (至少配置一个) ──────────────────────────────────────────
# 阿里云 DashScope (通义千问)
DASHSCOPE_API_KEY=your-dashscope-api-key

# 讯飞星火
SPARK_API_PASSWORD=
SPARK_API_KEY=
SPARK_API_URL=https://spark-api-open.xf-yun.com/agent/v1/chat/completions
SPARK_MODEL=spark-x

# DeepSeek (可选)
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# OpenAI (可选)
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1

# ── 数据库 ───────────────────────────────────────────────────────────────
# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eduagent
POSTGRES_PASSWORD=

# Neo4j 图数据库
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Elasticsearch
ES_HOSTS=http://127.0.0.1:9200
ES_USER=elastic
ES_PASSWORD=
# Local HTTP development can disable certificate validation. Managed
# staging/production Elasticsearch must use https and set this to true.
ES_VERIFY_CERTS=false
ES_CA_CERTS=

# Redis
# Use a long URL-safe value because Compose injects it into REDIS_URL.
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# MinIO (Milvus 对象存储)
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ── JWT ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=

# ── Preset accounts (development/testing only) ───────────────────────────
# These are only created in non-production environments (when APP_ENV != production).
# Leave empty to skip preset account creation.
PRESET_ADMIN_PASSWORD=Admin@2026!
PRESET_STUDENT_PASSWORD=Learn@2026

# ── Runtime / account email delivery ─────────────────────────────────────
# Development and test responses may include a one-time dev_token. Production
# never returns it. Password-reset and email-verification requests return
# 503 delivery_not_configured in production until SMTP_HOST and SMTP_FROM are set.
APP_ENV=development
PUBLIC_APP_URL=http://localhost:5173

# ── Release controls / operations ────────────────────────────────────────
# Local development may keep this tag and build with Docker Compose. Formal
# staging/production releases must replace it with a CI-published immutable
# reference such as registry.example/eduagent@sha256:<64 lowercase hex chars>.
EDUAGENT_IMAGE=eduagent-local:dev
# Exact keyless certificate identity emitted by the manual release workflow.
# Forks must replace the owner/repository and default branch.
EDUAGENT_COSIGN_IDENTITY=https://github.com/Joel-Ellen/ZXXC/.github/workflows/release-image.yml@refs/heads/main
EDUAGENT_COSIGN_OIDC_ISSUER=https://token.actions.githubusercontent.com

# Stable per-user rollout for isolated code practice. Allow/deny lists take
# precedence over the percentage and should contain comma-separated user IDs.
EDUAGENT_CODE_PRACTICE_ROLLOUT_PERCENT=0
EDUAGENT_CODE_PRACTICE_ROLLOUT_ALLOWLIST=
EDUAGENT_CODE_PRACTICE_ROLLOUT_DENYLIST=

# Whole-application access starts closed. Explicit allow/deny lists take
# precedence over the stable percentage cohort.
EDUAGENT_APP_ACCESS_ROLLOUT_PERCENT=0
EDUAGENT_APP_ACCESS_ROLLOUT_ALLOWLIST=
EDUAGENT_APP_ACCESS_ROLLOUT_DENYLIST=

# Durable resource jobs and their SSE stream use a stable per-user rollout.
# Keep production at 0 until an allowlist/cohort is ready; this development
# example enables the feature for local UI verification.
EDUAGENT_RESOURCE_GENERATION_ROLLOUT_PERCENT=100
EDUAGENT_RESOURCE_GENERATION_ROLLOUT_ALLOWLIST=
EDUAGENT_RESOURCE_GENERATION_ROLLOUT_DENYLIST=

# Production rate limits must share state across application instances.
EDUAGENT_RATE_LIMIT_BACKEND=redis
# Enable only when the application is reachable exclusively through a proxy
# that overwrites X-Forwarded-For (the provided Nginx configs do this).
EDUAGENT_TRUST_PROXY_HEADERS=false

EDUAGENT_ENABLE_PUBLIC_METRICS=false
EDUAGENT_OPS_TOKEN=

SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL=1
SMTP_STARTTLS=1

# Frontend test-account hint (shown only by the Vite dev server when explicitly enabled)
VITE_SHOW_TEST_ACCOUNTS=false

# Optional production frontend monitoring. Learning content and credentials are
# removed before events are sent.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05

# ── HuggingFace 镜像 (国内服务器必填) ────────────────────────────────────
HF_ENDPOINT=https://hf-mirror.com

# ── ChromaDB (迁移数据用，迁移后可移除) ──────────────────────────────────
CHROMA_PERSIST_DIR=./data/vector_db
