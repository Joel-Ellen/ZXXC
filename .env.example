# ============================================================================
# EduAgent 环境变量配置 (统一版 — merged from src/ + backend/)
# ============================================================================
# 复制此文件为 .env 并填写真实值:
#   cp .env.example .env
# ============================================================================

# ── LLM Provider (默认: dashscope) ───────────────────────────────────────
# 可选: dashscope | spark | deepseek | openai
LLM_PROVIDER=dashscope
# Optional comma-separated providers attempted only when their credentials are configured.
EDUAGENT_LLM_FALLBACKS=deepseek,openai

# Resource generation uses one bounded attempt per provider. The defaults allow
# a complete DashScope learning card to return without exceeding the frontend's
# 120-second request budget when five cards are generated with three workers.
EDUAGENT_RESOURCE_LLM_TIMEOUT_SEC=50
EDUAGENT_RESOURCE_LLM_TOTAL_TIMEOUT_SEC=55
EDUAGENT_RESOURCE_LLM_RETRIES=1
EDUAGENT_RESOURCE_LLM_PARALLELISM=3

# ── LLM API Keys (至少配置一个) ──────────────────────────────────────────
# 阿里云 DashScope (通义千问)
DASHSCOPE_API_KEY=your-dashscope-api-key

# 讯飞星火
SPARK_API_KEY=
SPARK_APP_ID=
SPARK_API_SECRET=
SPARK_API_URL=https://spark-api-open.xf-yun.com/v1

# DeepSeek (可选)
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# OpenAI (可选)
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1

# ── 数据库 ───────────────────────────────────────────────────────────────
# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eduagent
POSTGRES_PASSWORD=

# Neo4j 图数据库
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Elasticsearch
ES_HOSTS=http://127.0.0.1:9200
ES_USER=elastic
ES_PASSWORD=

# Redis
# Use a long URL-safe value because Compose injects it into REDIS_URL.
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# MinIO (Milvus 对象存储)
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ── JWT ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=

# ── Runtime / account email delivery ─────────────────────────────────────
# Development and test responses may include a one-time dev_token. Production
# never returns it. Password-reset and email-verification requests return
# 503 delivery_not_configured in production until SMTP_HOST and SMTP_FROM are set.
APP_ENV=development
PUBLIC_APP_URL=http://localhost:5173

# ── Release controls / operations ────────────────────────────────────────
# Local development may keep this tag and build with Docker Compose. Formal
# staging/production releases must replace it with a CI-published immutable
# reference such as registry.example/eduagent@sha256:<64 lowercase hex chars>.
EDUAGENT_IMAGE=eduagent-local:dev
# Exact keyless certificate identity emitted by the manual release workflow.
# Forks must replace the owner/repository and default branch.
EDUAGENT_COSIGN_IDENTITY=https://github.com/Joel-Ellen/ZXXC/.github/workflows/release-image.yml@refs/heads/main
EDUAGENT_COSIGN_OIDC_ISSUER=https://token.actions.githubusercontent.com

# Stable per-user rollout for isolated code practice. Allow/deny lists take
# precedence over the percentage and should contain comma-separated user IDs.
EDUAGENT_CODE_PRACTICE_ROLLOUT_PERCENT=0
EDUAGENT_CODE_PRACTICE_ROLLOUT_ALLOWLIST=
EDUAGENT_CODE_PRACTICE_ROLLOUT_DENYLIST=

# Whole-application access starts closed. Explicit allow/deny lists take
# precedence over the stable percentage cohort.
EDUAGENT_APP_ACCESS_ROLLOUT_PERCENT=0
EDUAGENT_APP_ACCESS_ROLLOUT_ALLOWLIST=
EDUAGENT_APP_ACCESS_ROLLOUT_DENYLIST=

# Production rate limits must share state across application instances.
EDUAGENT_RATE_LIMIT_BACKEND=redis
# Enable only when the application is reachable exclusively through a proxy
# that overwrites X-Forwarded-For (the provided Nginx configs do this).
EDUAGENT_TRUST_PROXY_HEADERS=false

# Legacy compatibility/reset routes are disabled by this example. In
# production they also require EDUAGENT_OPS_TOKEN when explicitly enabled.
EDUAGENT_ENABLE_COMPAT_API=false
EDUAGENT_ENABLE_PUBLIC_METRICS=false
EDUAGENT_OPS_TOKEN=

SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL=1
SMTP_STARTTLS=1

# Frontend test-account hint (shown only by the Vite dev server when explicitly enabled)
VITE_SHOW_TEST_ACCOUNTS=false

# Optional production frontend monitoring. Learning content and credentials are
# removed before events are sent.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05

# ── HuggingFace 镜像 (国内服务器必填) ────────────────────────────────────
HF_ENDPOINT=https://hf-mirror.com

# ── ChromaDB (迁移数据用，迁移后可移除) ──────────────────────────────────
CHROMA_PERSIST_DIR=./data/vector_db
