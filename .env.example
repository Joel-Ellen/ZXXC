# ============================================================================
# EduAgent 环境变量配置 (统一版 — merged from src/ + backend/)
# ============================================================================
# 复制此文件为 .env 并填写真实值:
#   cp .env.example .env
# ============================================================================

# ── LLM Provider (默认: dashscope) ───────────────────────────────────────
# 可选: dashscope | spark | deepseek | openai
LLM_PROVIDER=dashscope

# ── LLM API Keys (至少配置一个) ──────────────────────────────────────────
# 阿里云 DashScope (通义千问)
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here

# 讯飞星火
SPARK_API_KEY=
SPARK_APP_ID=
SPARK_API_SECRET=
SPARK_API_URL=https://spark-api-open.xf-yun.com/v1

# DeepSeek (可选)
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# OpenAI (可选)
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1

# ── 数据库 ───────────────────────────────────────────────────────────────
# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eduagent

# Neo4j 图数据库
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=EduAgent2024!

# Elasticsearch
ES_HOSTS=http://127.0.0.1:9200
ES_USER=elastic
ES_PASSWORD=EduAgent2024!

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO (Milvus 对象存储)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin2024

# ── JWT ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production

# ── HuggingFace 镜像 (国内服务器必填) ────────────────────────────────────
HF_ENDPOINT=https://hf-mirror.com

# ── ChromaDB (迁移数据用，迁移后可移除) ──────────────────────────────────
CHROMA_PERSIST_DIR=./data/vector_db
