# ============================================================================
# EduAgent 环境变量配置
# ============================================================================
# 复制此文件为 .env 并填写真实值:
#   cp .env.example .env
# ============================================================================

# ── LLM API Keys (至少配置一个) ──────────────────────────────────────────
# 阿里云 DashScope (通义千问)
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here

# 讯飞星火 (可选)
SPARK_API_KEY=
SPARK_APP_ID=
SPARK_API_SECRET=

# ── 数据库密码 ───────────────────────────────────────────────────────────
# Neo4j 图数据库
NEO4J_USER=neo4j
NEO4J_PASSWORD=EduAgent2024!

# MinIO (Milvus 对象存储)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin2024

# ── HuggingFace 镜像 (国内服务器必填) ────────────────────────────────────
# 用于下载 sentence-transformers 模型
HF_ENDPOINT=https://hf-mirror.com

# ── 可选: 自建数据库地址 ─────────────────────────────────────────────────
# 如果服务器上已有以下服务，可注释 docker-compose 中对应段落，
# 然后在这里填写连接地址：
# NEO4J_URI=bolt://localhost:7687
# ES_HOST=http://localhost:9200
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
